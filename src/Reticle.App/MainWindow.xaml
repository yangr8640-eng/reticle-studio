<Window x:Class="Reticle.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Reticle.App"
        Title="Reticle Studio · 准星工具" Width="1120" Height="810" MinWidth="950" MinHeight="680" Background="#10151E" Foreground="#ECF1F8" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Grid Margin="30,24,30,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,24">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="44" Height="44" Background="#203C34" CornerRadius="12" Margin="0,0,14,0"><TextBlock Text="⌖" Foreground="#67E8B0" FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
        <StackPanel><TextBlock Text="RETICLE STUDIO" FontSize="22" FontWeight="Bold"/><TextBlock Text="让每一次瞄准，都有自己的准星。" Foreground="#9AA9BD" FontSize="12" Margin="0,4,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#202B2A" CornerRadius="5" Padding="9,5" Margin="0,0,12,0"><TextBlock Text="WINDOWS  /  v0.2.0" Foreground="#9DC4B6" FontSize="10"/></Border>
        <Button Content="收起到托盘" Click="MinimizeToTray_Click" Padding="12,8"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="140"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="PreviewPlate" Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Background="#151F2C">
          <Grid>
            <Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="Transparent"><GeometryDrawing.Pen><Pen Brush="#173D4B5A" Thickness="0.5"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,0" EndPoint="32,0"/><LineGeometry StartPoint="0,0" EndPoint="0,32"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
            <Ellipse Width="180" Height="180" Stroke="#24425467" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="300" Height="300" Stroke="#183A4A5F" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <local:CrosshairView x:Name="Preview" Settings="{Binding}"/>
            <Grid Margin="20" VerticalAlignment="Top"><TextBlock Text="实时预览" FontWeight="SemiBold"/><Border HorizontalAlignment="Right" Background="#223C34" CornerRadius="4" Padding="7,3"><TextBlock Text="LIVE" Foreground="#67E8B0" FontSize="10"/></Border></Grid>
            <Grid Margin="20" VerticalAlignment="Bottom">
              <TextBlock x:Name="PreviewCaption" Text="1× 实际像素" Foreground="#9AA9BD" VerticalAlignment="Center" FontSize="11"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="1× / 4×" Click="Zoom_Click" Padding="9,6" FontSize="11" Margin="0,0,7,0"/><Button Content="切换背景" Click="Background_Click" Padding="9,6" FontSize="11"/></StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16">
          <StackPanel><TextBlock Text="从一个预设开始" Style="{StaticResource Section}"/>
            <UniformGrid Columns="4"><Button Content="经典绿" Tag="classic" Click="Preset_Click" Margin="0,0,7,0" Padding="8,9"/><Button Content="冰蓝斜十字" Tag="diagonal" Click="Preset_Click" Margin="0,0,7,0" Padding="6,9" FontSize="11"/><Button Content="琥珀圆环" Tag="circle" Click="Preset_Click" Margin="0,0,7,0" Padding="8,9" FontSize="11"/><Button Content="极简白" Tag="precision" Click="Preset_Click" Padding="8,9"/></UniformGrid>
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
          <StackPanel>
            <Grid Margin="0,0,0,15"><StackPanel><TextBlock x:Name="OverlayStatus" Text="桌面准星已关闭" FontWeight="SemiBold"/><TextBlock Text="Ctrl + Alt + H  随时显示 / 隐藏" Foreground="#9AA9BD" FontSize="11" Margin="0,6,0,0"/></StackPanel><Ellipse x:Name="StatusDot" Fill="#657082" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0"/></Grid>
            <Button x:Name="ToggleButton" Content="开启桌面准星" Click="ToggleOverlay_Click" Background="#67E8B0" BorderBrush="#67E8B0" Foreground="#10261D" FontWeight="Bold" Padding="14,13"/>
            <TextBlock Text="建议使用游戏的无边框窗口模式。" Foreground="#9AA9BD" FontSize="11" Margin="0,12,0,0" TextAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,19,12,16">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,10,15"><TextBlock Text="打造你的准星" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Content="重置外观" Click="Reset_Click" Padding="10,6" FontSize="11"/></Grid>
          <Grid DockPanel.Dock="Bottom" Margin="0,14,10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="导入配置" Click="Import_Click"/><Button Grid.Column="2" Content="导出配置" Click="Export_Click"/></Grid>
          <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
              <TextBlock Text="01  /  形状" Style="{StaticResource Section}"/>
              <UniformGrid Columns="3" Margin="0,0,0,22"><Button x:Name="CrossButton" Content="＋   十字" Tag="Cross" Click="Shape_Click" Margin="0,0,8,0"/><Button x:Name="DiagonalButton" Content="×   斜十字" Tag="Diagonal" Click="Shape_Click" Margin="0,0,8,0"/><Button x:Name="CircleButton" Content="○   圆形" Tag="Circle" Click="Shape_Click"/></UniformGrid>
              <TextBlock Text="02  /  尺寸与间距" Style="{StaticResource Section}"/>
              <Grid><TextBlock Text="线条粗细"/><TextBlock Text="{Binding Thickness, StringFormat={}{0:0.#} px}" HorizontalAlignment="Right" Foreground="#67E8B0"/></Grid>
              <Slider Minimum="1" Maximum="16" TickFrequency="0.5" Value="{Binding Thickness}" AutomationProperties.Name="线条粗细"/>
              <StackPanel x:Name="ArmsControls">
                <Grid><TextBlock Text="线条长度"/><TextBlock Text="{Binding Length, StringFormat={}{0:0.#} px}" HorizontalAlignment="Right" Foreground="#67E8B0"/></Grid><Slider Minimum="1" Maximum="80" Value="{Binding Length}" AutomationProperties.Name="线条长度"/>
                <Grid><TextBlock Text="中心间距"/><TextBlock Text="{Binding Gap, StringFormat={}{0:0.#} px}" HorizontalAlignment="Right" Foreground="#67E8B0"/></Grid><Slider Minimum="0" Maximum="80" Value="{Binding Gap}" AutomationProperties.Name="中心间距"/>
              </StackPanel>
              <StackPanel x:Name="CircleControls" Visibility="Collapsed"><Grid><TextBlock Text="圆环半径"/><TextBlock Text="{Binding Radius, StringFormat={}{0:0.#} px}" HorizontalAlignment="Right" Foreground="#67E8B0"/></Grid><Slider Minimum="2" Maximum="100" Value="{Binding Radius}" AutomationProperties.Name="圆环半径"/></StackPanel>
              <TextBlock Text="03  /  颜色与透明度" Style="{StaticResource Section}" Margin="0,15,0,12"/>
              <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Width="28" Height="28" Padding="0" Background="#67E8B0" Tag="#67E8B0" Click="Color_Click" Margin="0,0,8,0" ToolTip="薄荷绿"/><Button Width="28" Height="28" Padding="0" Background="#71C7FF" Tag="#71C7FF" Click="Color_Click" Margin="0,0,8,0" ToolTip="冰蓝"/><Button Width="28" Height="28" Padding="0" Background="#FFC66D" Tag="#FFC66D" Click="Color_Click" Margin="0,0,8,0" ToolTip="琥珀"/><Button Width="28" Height="28" Padding="0" Background="#FF7AA2" Tag="#FF7AA2" Click="Color_Click" Margin="0,0,8,0" ToolTip="玫红"/><Button Width="28" Height="28" Padding="0" Background="#F4F6FC" Tag="#F4F6FC" Click="Color_Click" ToolTip="白色"/></StackPanel>
                <TextBox Grid.Column="1" x:Name="ColorInput" MaxLength="7" TextChanged="ColorInput_Changed" AutomationProperties.Name="十六进制颜色" FontFamily="Consolas" FontSize="14" VerticalContentAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="ColorError" Text="颜色格式：#RRGGBB" Foreground="#FFACAC" FontSize="10" Visibility="Collapsed" Margin="0,0,0,6"/>
              <Expander x:Name="PaletteExpander" Header="调色盘 · 自由选色" Expanded="Palette_Expanded" Foreground="#DAE3EF" Margin="0,2,0,12">
                <local:ColorPalette x:Name="Palette" SelectedColor="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              </Expander>
              <Grid><TextBlock Text="不透明度"/><TextBlock Text="{Binding Opacity, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="#67E8B0"/></Grid><Slider Minimum="0" Maximum="100" Value="{Binding Opacity}" AutomationProperties.Name="不透明度"/>
              <CheckBox Content="显示中心点" IsChecked="{Binding CenterDot}"/>
              <StackPanel IsEnabled="{Binding CenterDot}"><Grid><TextBlock Text="中心点直径" Foreground="#9AA9BD"/><TextBlock Text="{Binding DotSize, StringFormat={}{0:0.#} px}" HorizontalAlignment="Right" Foreground="#9AA9BD"/></Grid><Slider Minimum="1" Maximum="20" Value="{Binding DotSize}" AutomationProperties.Name="中心点直径"/></StackPanel>
              <CheckBox Content="黑色描边 · 增强亮背景对比度" IsChecked="{Binding Outline}"/>
              <StackPanel IsEnabled="{Binding Outline}"><Grid><TextBlock Text="描边宽度" Foreground="#9AA9BD"/><TextBlock Text="{Binding OutlineWidth, StringFormat={}{0:0.#} px}" HorizontalAlignment="Right" Foreground="#9AA9BD"/></Grid><Slider Minimum="0.5" Maximum="6" TickFrequency="0.5" Value="{Binding OutlineWidth}" AutomationProperties.Name="描边宽度"/></StackPanel>
              <TextBlock Text="04  /  显示位置" Style="{StaticResource Section}" Margin="0,15,0,12"/>
              <ComboBox x:Name="MonitorBox" DisplayMemberPath="Label" SelectedValuePath="Device" SelectionChanged="Monitor_Changed" Padding="8" Margin="0,0,0,14" AutomationProperties.Name="显示器"/>
              <Grid><TextBlock Text="水平偏移"/><TextBlock Text="{Binding OffsetX, StringFormat={}{0:0} px}" HorizontalAlignment="Right" Foreground="#67E8B0"/></Grid><Slider Minimum="-500" Maximum="500" Value="{Binding OffsetX}" AutomationProperties.Name="水平偏移"/>
              <Grid><TextBlock Text="垂直偏移"/><TextBlock Text="{Binding OffsetY, StringFormat={}{0:0} px}" HorizontalAlignment="Right" Foreground="#67E8B0"/></Grid><Slider Minimum="-500" Maximum="500" Value="{Binding OffsetY}" AutomationProperties.Name="垂直偏移"/>
              <Button Content="重新居中" Click="Center_Click" Padding="10,7" HorizontalAlignment="Left"/>
              <TextBlock Text="Ctrl + Alt + S  打开设置窗口" Foreground="#9AA9BD" FontSize="11" Margin="0,16,0,0"/>
              <TextBlock x:Name="HotkeyWarning" Foreground="#FFC66D" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="SaveStatus" Text="配置仅保存在本机" Foreground="#9AA9BD" FontSize="11"/><TextBlock Text="独立桌面覆盖层  ·  鼠标穿透" HorizontalAlignment="Right" Foreground="#748499" FontSize="11"/></Grid>
  </Grid>
</Window>
