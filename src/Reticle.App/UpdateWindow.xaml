<Window x:Class="Reticle.App.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新 · Reticle Studio" Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#10151E" Foreground="#ECF1F8" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
  <StackPanel Margin="26">
    <TextBlock Text="检查更新" FontSize="22" FontWeight="Bold"/>
    <TextBlock x:Name="CurrentVersionText" Foreground="#9AA9BD" Margin="0,10,0,8"/>
    <CheckBox x:Name="IncludePreview" Content="包含预览版" Click="Check_Click"/>
    <Border Style="{StaticResource Card}" Margin="0,12,0,16" Padding="18" MinHeight="105">
      <StackPanel>
        <TextBlock x:Name="StatusText" Text="正在检查更新…" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="DetailText" Foreground="#9AA9BD" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <TextBlock Text="检查时连接 GitHub 获取版本信息。下载后解压运行；全屏 Game Bar 组件如有更新，需单独安装。" Foreground="#9AA9BD" FontSize="11" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="CheckButton" Content="重新检查" Click="Check_Click" Margin="0,0,10,0"/>
      <Button x:Name="DownloadButton" Content="打开发布页" Click="Download_Click" Background="#234337" BorderBrush="#67E8B0"/>
    </StackPanel>
  </StackPanel>
</Window>
