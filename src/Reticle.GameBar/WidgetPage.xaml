<Page x:Class="Reticle.GameBar.WidgetPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Reticle.GameBar" Background="Transparent" RequestedTheme="Dark">
  <Grid Background="Transparent">
    <local:CrosshairCanvas x:Name="Reticle" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    <Border x:Name="Instructions" Background="#E610151E" VerticalAlignment="Top" Margin="8" Padding="12" CornerRadius="6" MaxHeight="160">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="7">
        <TextBlock Text="固定图钉并开启鼠标穿透，再关闭 Game Bar。" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock x:Name="WidgetStatus" FontSize="11" TextWrapping="Wrap" Foreground="#A8B6C7"/>
        <Button Content="重新居中" Click="Center_Click" Padding="10,5" HorizontalAlignment="Left"/>
        <TextBlock x:Name="ReadStatus" FontSize="11" TextWrapping="Wrap" Foreground="#D9B778"/>
        <TextBlock x:Name="PositionStatus" FontSize="11" TextWrapping="Wrap" Foreground="#D9B778"/>
      </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Page>
