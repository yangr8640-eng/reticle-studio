<Application x:Class="Reticle.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#181E29"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A3342"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA9BD"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#67E8B0"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#DAE3EF"/><Setter Property="Background" Value="#232D3C"/>
      <Setter Property="BorderBrush" Value="#344052"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#67E8B0"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="White"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#ECF1F8"/><Setter Property="Background" Value="#101722"/>
      <Setter Property="BorderBrush" Value="#344052"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="CaretBrush" Value="#67E8B0"/><Setter Property="SelectionBrush" Value="#337F65"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DAE3EF"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,7,0,7"/></Style>
    <Style x:Key="SliderRepeat" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="3" CornerRadius="1.5"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="#67E8B0"/><Setter Property="Margin" Value="0,7,0,8"/><Setter Property="Height" Value="20"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="0,0,1,0">
        <Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="#67E8B0" Style="{StaticResource SliderRepeat}"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="#3A4656" Style="{StaticResource SliderRepeat}"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#D6F6E9" Stroke="#67E8B0" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#2D3B4B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#9AA9BD"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#181E29"/><Setter Property="BorderBrush" Value="#2A3342"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/></Style>
  </Application.Resources>
</Application>
