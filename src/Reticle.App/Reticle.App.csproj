<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Reticle</AssemblyName>
    <RootNamespace>Reticle.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\reticle.ico</ApplicationIcon>
    <!-- WPF owns the message loop; PerMonitorV2 is declared in its manifest.
         WinForms is used only for Screen and NotifyIcon, not Application.Run. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reticle.Core\Reticle.Core.csproj" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
